{
  "name": "afterglow-ui",
  "version": "0.1.0",
  "description": "CSS-first UI kit for dense desktop apps: compositor-only motion, zero runtime dependencies, no framework required.",
  "type": "module",
  "license": "MIT",
  "author": "Weidows",
  "homepage": "https://github.com/Weidows/afterglow-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weidows/afterglow-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Weidows/afterglow-ui/issues"
  },
  "keywords": [
    "ui",
    "design-system",
    "components",
    "css",
    "vanilla-js",
    "desktop",
    "motion",
    "mygo"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/afterglow.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:gallery": "vite build --mode gallery",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.1.0"
  }
}
